# Gmail SMTP (use an App Password — not your normal Gmail password)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Google Account → Security → App passwords → create one for "Mail"
# 3. Paste the 16-character app password into SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=momina109malik@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Inbox that receives portfolio form messages (defaults to SMTP_USER)
CONTACT_TO=momina109malik@gmail.com

# Local contact API
CONTACT_API_PORT=8787
